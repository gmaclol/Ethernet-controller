    <path android:pathData="M43,36 L43,44" android:strokeWidth="1.8" android:strokeColor="#00E5FF" android:strokeLineCap="round" />
    <!-- Pin 2 -->
    <path android:pathData="M46,36 L46,44" android:strokeWidth="1.8" android:strokeColor="#38BDF8" android:strokeLineCap="round" />
